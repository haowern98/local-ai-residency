session id=1 backend=llama model="{{LLAMA_MODEL}}" prompt="{{PROMPT_TEXT}}" ctx={{LLAMA_CTX}} batch={{LLAMA_BATCH}} gpu_layers={{LLAMA_GPU_LAYERS}} device={{DEVICE}} threads={{THREADS}} use_mmap={{LLAMA_USE_MMAP}} use_mlock={{LLAMA_USE_MLOCK}} use_direct_io={{LLAMA_USE_DIRECT_IO}} check_tensors={{LLAMA_CHECK_TENSORS}}

step op=load session=1
step op=prefill session=1
step op=save session=1
step op=baseline session=1
step op=evict_context session=1
step op=evict_model session=1
step op=reload_model session=1
step op=restore session=1
step op=resume_check session=1
