  init: {
    "theme": "default",
    "flowchart": {
      "nodeSpacing": 100,
      "rankSpacing": 120,
      "padding": 24
    },
    "themeVariables": {
      "fontFamily": "trebuchet ms, verdana, arial, sans-serif",
